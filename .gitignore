# ─── ML model binaries — too large for git, download separately ───────────────
# rx_ocr_quantized.tflite is 545 MB — exceeds GitHub's 100 MB limit.
# Download from the Kaggle training output and place in public/models/.
public/models/*.tflite
public/models/tokenizer.json
public/models/special_tokens_map.json
public/models/tokenizer_config.json
# drug_dictionary.json is generated from the Tata 1mg Kaggle dataset
# Run the extraction script and place the output here
public/models/drug_dictionary.json

